<?xml version="1.0" encoding="utf-8"?>
<!-- The Remote Viewer Network — v0.1 Android manifest.
     No permissions requested. The whole app is one NativeActivity whose
     native entry point (ANativeActivity_onCreate) lives in libtrv_android.so.
     Assembled with aapt2 directly — no Gradle, no Play Services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="network.remoteviewer.trv"
    android:versionCode="6"
    android:versionName="0.5.0">

    <application
        android:label="The Remote Viewer Network"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboard|keyboardHidden|screenLayout|screenSize|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="trv_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- TRV home-screen widget: build progress today, founder's
             network-health dashboard tomorrow. Java in
             android/java/network/remoteviewer/trv/. -->
        <receiver
            android:name="network.remoteviewer.trv.TrvWidgetProvider"
            android:exported="false"
            android:label="TRV Progress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trv_widget_info" />
        </receiver>
    </application>
</manifest>
